#!/usr/bin/env python3.11
"""Repository-local crosscheckctl entry point."""

import sys
from pathlib import Path

# Running ``bin/crosscheckctl`` directly places only ``bin/`` on sys.path.
# Add the source checkout root without depending on an editable install.
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from crosscheck_council.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
