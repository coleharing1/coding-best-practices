{
  "description": "Expose only the current Claude transcript path to explicit crosscheck commands.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
